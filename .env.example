# Neon connection string. Get this from your Neon project dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random secret used to sign driver and admin session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional: a self-hosted fonek (https://github.com/lodjim/fonek) backend,
# used as a backup bus locator when a driver's phone GPS isn't available.
# Leave both blank to disable the fallback locator entirely.
FONEK_BASE_URL=
FONEK_API_KEY=
